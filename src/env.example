# Databricks Workspace Configuration
DATABRICKS_HOST= # e.g., https://e2-dogfood.staging.cloud.databricks.com
DATABRICKS_CLIENT_ID= # Service Principal Client ID
DATABRICKS_CLIENT_SECRET= # Service Principal Client Secret

# Destination Table Configuration
CATALOG= # The catalog for the destination table (e.g., m_demo_catalog)
SCHEMA= # The schema for the destination table (e.g., demo_schema)
TABLE= # The destination table name (e.g., air_quality)

# Databricks ZeroBus Configuration
ZEROBUS_WORKSPACE_ID= # The workspace ID for the Zerobus endpoint (e.g., 3692013451947905)

